{
  "name": "qb-content",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Quiet Bands Content: single-user local prototype of the reel approval and revision workflow.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "render-service": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "node scripts/dev.mjs preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@napi-rs/canvas": "^1.0.10",
    "busboy": "^1.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
